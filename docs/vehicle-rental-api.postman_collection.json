{
  "info": {
    "_postman_id": "9eec30cb-ef1f-4b5c-875d-f8c2ff6203cb",
    "name": "Vehicle Rental Management API",
    "description": "Phase 2 API collection. Run Login first to save the returned JWT into the collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "vehicleId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "rentalId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.token) pm.collectionVariables.set('jwt_token', body.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@rental.local\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Authenticates seeded staff and stores the JWT in {{jwt_token}}."
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "List Vehicles",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/vehicles?page=1&limit=20"
          }
        },
        {
          "name": "Get Vehicle",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}"
          }
        },
        {
          "name": "Create Vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  const id = body.data ? body.data.id : body.id;",
                  "  if (id) pm.collectionVariables.set('vehicleId', String(id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Toyota Premio 2025\",\n  \"plate_number\": \"DHAKA-METRO-GA-99-9001\",\n  \"category\": \"Sedan\",\n  \"daily_rate\": 5500,\n  \"photo_path\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/vehicles"
          }
        },
        {
          "name": "Update Vehicle",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"daily_rate\": 5750\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}"
          }
        },
        {
          "name": "Delete Vehicle",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}"
          }
        }
      ]
    },
    {
      "name": "Rentals",
      "item": [
        {
          "name": "List Rentals",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rentals?status=booked"
          }
        },
        {
          "name": "Get Rental",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rentals/{{rentalId}}"
          }
        },
        {
          "name": "Create Rental",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  const id = body.data ? body.data.id : body.id;",
                  "  if (id) pm.collectionVariables.set('rentalId', String(id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": {{vehicleId}},\n  \"customer_name\": \"Aminul Islam\",\n  \"customer_phone\": \"+8801711000001\",\n  \"start_date\": \"2026-07-29\",\n  \"end_date\": \"2026-08-03\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/rentals"
          }
        },
        {
          "name": "Update Rental Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ongoing\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/rentals/{{rentalId}}"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Monthly Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/reports/rentals?month=2026-08",
            "description": "Requests August 2026 data, including the seeded rental spanning July and August."
          }
        }
      ]
    }
  ]
}
