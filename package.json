{
  "name": "vehicle-rental-management-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for vehicle rental management",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "node init && tsx watch src/server.ts",
    "start:dev": "node init && node dist/src/server.js",
    "build": "node init && tsc -p tsconfig.json",
    "start": "node init && node dist/src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --detectOpenHandles",
    "db:migrate": "knex --knexfile knexfile.production.cjs migrate:latest",
    "db:rollback": "knex --knexfile knexfile.production.cjs migrate:rollback",
    "db:seed": "knex --knexfile knexfile.production.cjs seed:run",
    "db:migrate:dev": "knex --knexfile knexfile.ts migrate:latest",
    "db:rollback:dev": "knex --knexfile knexfile.ts migrate:rollback",
    "db:seed:dev": "knex --knexfile knexfile.ts seed:run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.2.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
